import { PostLi } from "@/components/post-li";
import { getPostItems } from "@/model/post";

export const Route = createFileRoute("/")({
  loader: async () => {
    const posts = await getPostItems({ data: { start: 0, end: 3 } });
    return { posts };
  },
  component: Component,
});

export function Component() {
